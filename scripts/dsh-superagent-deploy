#!/usr/bin/env python3
"""Deploy a commit of this checkout to the running dsh-superagent service, and roll back if it does not come up healthy.

Steps: check the checkout is clean, fetch, require the target commit to be on the deploy branch (default origin/main),
and build it in a temporary worktree while the service keeps running, so a failed build never touches the running
checkout. Then stop the service, back up its now quiescent database, check out and build the target in place, start
it through scripts/dsh-superagent and require exit 0. If the start fails, the previous commit is checked out, rebuilt
and started again; the database is restored from the backup only when the failed version changed its schema, so the
messages it recorded as sent are not sent again. Each run appends one line to the deploy log.

Exit 0 deployed (or nothing to do), 1 failed and the previous version runs, 2 refused before any change, 3 failed and
the rollback failed too: a person must act.
"""

import argparse
import datetime
import os
from pathlib import Path
import re
import shutil
import sqlite3
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent
SERVICE = ROOT / 'scripts' / 'dsh-superagent'
KEEP_BACKUPS = 10


class Refused(Exception):
    """A precondition failed before anything changed."""


def run(*argv, check=True, quiet=False, cwd=ROOT):
    """Run a command in the checkout (or `cwd`) and return its stdout; a failure raises with its output."""
    result = subprocess.run(argv, cwd=cwd, capture_output=True, text=True)
    if not quiet and result.stdout.strip():
        print(result.stdout.rstrip())
    if check and result.returncode != 0:
        raise RuntimeError(f'{" ".join(argv)} exited {result.returncode}: {(result.stderr or result.stdout).strip()[-2000:]}')
    return result


def git(*args):
    return run('git', *args, quiet=True).stdout.strip()


def log_line(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('a') as out:
        out.write(f'{datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")} {text}\n')
    print(f'logged: {text}')


def build(cwd=ROOT):
    print('== pnpm install && pnpm build' + ('' if cwd == ROOT else f' in {cwd}'))
    run('pnpm', 'install', '--frozen-lockfile', quiet=True, cwd=cwd)
    run('pnpm', 'build', quiet=True, cwd=cwd)


def trial_build(commit):
    """Build `commit` in a temporary worktree, leaving the running checkout alone; a failure raises."""
    parent = Path(tempfile.mkdtemp(prefix='dsh-superagent-build-'))
    tree = parent / 'tree'
    try:
        git('worktree', 'add', '--quiet', '--detach', str(tree), commit)
        build(tree)
    finally:
        run('git', 'worktree', 'remove', '--force', str(tree), check=False, quiet=True)
        shutil.rmtree(parent, ignore_errors=True)


def schema(database):
    """The schema version the database records, or None without one."""
    if not database.exists():
        return None
    with sqlite3.connect(f'file:{database}?mode=ro', uri=True) as db:
        try:
            row = db.execute("select value from kv where key = 'schema'").fetchone()
        except sqlite3.Error:
            return None
    return row[0] if row else None


def backup(database, directory, commit):
    """Copy the database with SQLite's online backup, and keep the newest KEEP_BACKUPS copies."""
    if not database.exists():
        print(f'no database at {database}; nothing to back up')
        return None
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
    target = directory / f'orchestrator-{stamp}-{commit}.sqlite'
    with sqlite3.connect(f'file:{database}?mode=ro', uri=True) as source, sqlite3.connect(target) as copy:
        source.backup(copy)
    target.chmod(0o600)
    for old in sorted(directory.glob('orchestrator-*.sqlite'))[:-KEEP_BACKUPS]:
        old.unlink()
    print(f'database backed up to {target}')
    return target


def service(action, args):
    print(f'== dsh-superagent {action}')
    result = run(sys.executable, str(SERVICE), action, '--profile', args.profile, '--url', args.url,
                 '--timeout', str(args.timeout), check=False)
    return result.returncode


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('commit', nargs='?', help='commit, tag or branch to deploy (default: the tip of --branch)')
    parser.add_argument('--branch', default='origin/main', help='the target must be contained in this ref (default origin/main)')
    parser.add_argument('--profile', default=os.environ.get('DSH_SUPERAGENT_PROFILE') or 'superagent')
    parser.add_argument('--url', default=os.environ.get('DSH_SUPERAGENT_URL') or 'http://127.0.0.1:3082')
    parser.add_argument('--state-dir', type=Path, required=True, help="the plugin's stateDir, which holds orchestrator.sqlite")
    parser.add_argument('--backup-dir', type=Path, help='where database backups go (default <state-dir>/../backups)')
    parser.add_argument('--log', type=Path, default=Path.home() / 'deploy.log', help='deploy log (default ~/deploy.log)')
    parser.add_argument('--timeout', type=float, default=120, help='startup health-check timeout in seconds')
    parser.add_argument('--dry-run', action='store_true', help='print what would be deployed and change nothing')
    args = parser.parse_args()
    if not re.fullmatch(r'[A-Za-z0-9_][A-Za-z0-9_.-]*', args.profile):
        parser.error('--profile must be a DSH profile name')
    database = args.state_dir / 'orchestrator.sqlite'
    backups = args.backup_dir or args.state_dir.parent / 'backups'

    try:
        # The build needs pnpm and the restart (and its rollback) needs dsh and tmux; finding one missing only after the
        # service stopped would leave it down. A non-login ssh shell often lacks ~/.local/bin.
        missing = [name for name in ('pnpm', 'dsh', 'tmux') if not shutil.which(name)]
        if missing:
            raise Refused(f'{", ".join(missing)} not found on PATH ({os.environ.get("PATH", "")}); '
                          'run from a login shell or add their directory to PATH')
        if git('status', '--porcelain', '--untracked-files=no'):
            raise Refused('the checkout has uncommitted changes; commit or discard them first')
        git('fetch', '--quiet', 'origin')
        previous = git('rev-parse', 'HEAD')
        try:
            target = git('rev-parse', '--verify', f'{args.commit or args.branch}^{{commit}}')
        except RuntimeError:
            raise Refused(f'unknown commit {args.commit or args.branch}') from None
        if run('git', 'merge-base', '--is-ancestor', target, args.branch, check=False, quiet=True).returncode != 0:
            raise Refused(f'{target[:7]} is not on {args.branch}; deploy only commits that were merged there')
        # An untracked file where the target adds a tracked one would make the checkout abort halfway.
        added = set(git('diff', '--name-only', '--diff-filter=A', previous, target).splitlines())
        blocking = sorted(added & set(git('ls-files', '--others', '--exclude-standard').splitlines()))
        if blocking:
            raise Refused('untracked files would be overwritten by the target commit: ' + ', '.join(blocking))
    except Refused as error:
        print(f'refused: {error}', file=sys.stderr)
        return 2

    short = lambda sha: git('log', '-1', '--format=%h %s', sha)[:72]
    print(f'current: {short(previous)}')
    print(f'target:  {short(target)}')
    if target == previous:
        print('already deployed; nothing to do')
        return 0
    print(git('log', '--oneline', f'{previous}..{target}') or '(target is older than the current commit: a rollback)')
    if args.dry_run:
        print('dry run: nothing changed')
        return 0

    # A failed build never stops the service: the target is built in a worktree of its own first.
    try:
        trial_build(target)
    except RuntimeError as error:
        print(f'build failed: {error}', file=sys.stderr)
        log_line(args.log, f'{target[:7]} FAILED build; kept {previous[:7]} running')
        return 1

    if service('stop', args) != 0:
        # The previous version still runs from an unchanged checkout; start clears the stop marker the stop wrote.
        service('start', args)
        log_line(args.log, f'{target[:7]} not deployed: the service did not stop; {previous[:7]} keeps running')
        return 1
    # Stopped, the database takes no writes, so the backup holds everything the previous version recorded.
    saved = backup(database, backups, previous[:7])
    before = schema(database)
    try:
        git('checkout', '--quiet', '--detach', target)
        build()
        code = service('start', args)
    except RuntimeError as error:
        print(f'deploy failed: {error}', file=sys.stderr)
        code = None
    if code == 0:
        log_line(args.log, f'{short(target)} deployed (was {previous[:7]})')
        return 0

    failure = f'FAILED start ({code})' if code is not None else 'FAILED build in place'
    print(f'{failure}; rolling back to {previous[:7]}', file=sys.stderr)
    try:
        service('stop', args)
        git('checkout', '--quiet', '--detach', previous)
        build()
        # The previous version refuses a database of a newer schema; with the schema unchanged, keeping the database keeps
        # the receipts of messages the failed version sent, which a restore would make the previous version send again.
        if saved and schema(database) != before:
            shutil.copy2(saved, database)
            for suffix in ('-wal', '-shm'):
                Path(f'{database}{suffix}').unlink(missing_ok=True)
            print(f'database restored from {saved}: the failed version changed its schema')
        back = service('start', args)
    except RuntimeError as error:
        log_line(args.log, f'{target[:7]} {failure}; rollback to {previous[:7]} failed: {error}')
        return 3
    if back != 0:
        log_line(args.log, f'{target[:7]} {failure}; rolled back to {previous[:7]} but it exits {back}')
        return 3
    log_line(args.log, f'{target[:7]} {failure}; rolled back to {previous[:7]}')
    return 1

if __name__ == '__main__':
    sys.exit(main())
