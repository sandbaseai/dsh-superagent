#!/usr/bin/env python3
"""Group the last day's on-call tickets by root cause, keep the list of known open issues, and post a digest to Feishu.

It reads the tickets (titles and the conclusions of their reports) through the dsh-superagent management API, asks the model
through the Anthropic-compatible gateway to group them and to match them with the known issues, writes the updated
list as JSON and as Markdown (which workers read with `dsh-oncall known` before investigating), and posts the digest
with a bot-only lark-cli. It changes no system and no setting.

  oncall-ticket-digest [--url http://127.0.0.1:3082] --known FILE --chat oc_... [--hours 24] [--dry-run]

With --sessions (the DSH sessions directory on this machine), it also checks a sample of the window's finished tickets: it
reads each worker's Session, read-only, and asks the model whether the reply is backed by what the worker saw, counting the
replies that assert a cause, or that something is unaffected, without evidence.

With --brief it posts a short summary of the last --hours (3 by default) instead: how the window's alarms were handled,
what a person should look at, and which known issues kept firing. It reads the known list and writes nothing. Before it
posts, each item to look at must name a ticket of the window that has a conclusion, and a second model call checks each
against that ticket's report; an item either check refuses is left out, and one the review doubts is marked 待确认.

Exit 0 posted (or printed with --dry-run), 1 the model, the management API or the post failed, 2 a bad argument.
"""

import argparse
import concurrent.futures
import glob
import random
import datetime
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request

CONCLUSION_CHARS = 400
MAX_TICKETS = 150
PAGE = 200
UP = {'thumbsup'}
DOWN = {'thumbsdown'}
# A known issue with no ticket for this long is marked quiet; one quiet this long is dropped from the list.
QUIET_HOURS = 48
DROP_DAYS = 7
SHANGHAI = datetime.timezone(datetime.timedelta(hours=8))
PROMPT = """You maintain the on-call team's list of known open issues and write their daily digest.

Below are the known issues from earlier days (JSON) and the tickets of the last {hours} hours: each with its id, time,
alarm title and the conclusion its worker reported. Group the tickets by root cause: the same upstream provider failing
the same way, the same page section, the same database load, the same false-alarm pattern of one alarm rule. Match a
group to a known issue when it is the same cause, and keep that issue's key; otherwise give it a new short kebab-case key.

Answer with one JSON object and nothing else:
{{"issues": [{{"key": "...", "title": "short Chinese title naming the thing and the cause",
  "cause": "one or two Chinese sentences: what happens and why, from the conclusions",
  "action": "one Chinese sentence: what a person should do, or 无需处理",
  "owner": "who acts in Chinese, such as 供应商对接 / 前端 / 数据库 / 告警规则 / 无",
  "needs_human": true or false, "ticket_ids": ["..."]}}],
 "headline": "one Chinese sentence on the day: how many tickets, how many needed a person, the most important issue"}}

Put every ticket in exactly one issue. needs_human is true only when a person has to fix or decide something (a real
fault, a broken page, a quota, a config); a false alarm that only needs a rule change is needs_human false with owner
告警规则. A ticket with fix_pr asked for that pull request to fix its problem, and its conclusion may only talk about the
fix, merge or release: group it with the problem its title and the other tickets show, never as an issue about the pull
request. Use only what the conclusions say; do not invent causes.

Known issues:
{known}

Tickets:
{tickets}
"""


# The evidence check: how much of a worker's Session the model reads, and how many tickets a day it checks.
SEEN_CHARS = 140_000
ITEM_CHARS = 12_000
CHECK_PROMPT = """You audit an on-call agent. Below is its reply to an alert, then everything it saw: [input] messages (the alert card, known
issues, notes) and its tool calls with their results. Judge only whether the reply is backed by what it saw; do not judge whether
you would have reached another cause. Numbers computed from what it saw (sums, ratios, rounding) count as backed; times may differ
by time zone (UTC vs +08:00); a result cut short or a part of the transcript omitted is NOT a fault of the reply: treat a claim
that may rest on missing text as backed.
Classify:
- major: the cause in 结论 is contradicted by what it saw, or rests on nothing it saw; or 结论/影响 asserts no fault or no impact
  (for example "服务没有异常", "上游没有报错", "没有用户受影响") that it never checked or that its results contradict.
- minor: a figure, name or detail is wrong or unbacked, or a claim is stated more firmly than a sample supports, without changing
  the cause.
Answer with JSON only: {{"major": ["<one short Chinese sentence each>"], "minor": ["<one short Chinese sentence each>"]}}

REPLY:
{reply}

WHAT IT SAW:
{seen}
"""


class Invalid(Exception):
    """A bad argument."""


def now_utc():
    return datetime.datetime.now(datetime.timezone.utc)


def parse_time(text):
    return datetime.datetime.fromisoformat(text.replace('Z', '+00:00'))


def conclusion(summary):
    """The **结论** part of a report, else its first lines, cut to CONCLUSION_CHARS."""
    match = re.search(r'\*\*(?:结论|Conclusion)\*\*\s*[:：]?\s*([\s\S]*?)(?=\n\s*\*\*[^*\n]+\*\*|$)', summary or '')
    text = re.sub(r'\s+', ' ', (match.group(1) if match else summary or '')).strip()
    return text[:CONCLUSION_CHARS]


def management(url, path):
    """GET `path` of the dsh-superagent management API at `url`, which accepts the panel's marker header on loopback only."""
    request = urllib.request.Request(url.rstrip('/') + '/orchestrator/api/' + path,
                                     headers={'x-orchestrator-request': '1', 'accept': 'application/json'})
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return json.loads(response.read())
    except urllib.error.HTTPError as error:
        raise RuntimeError(f'GET {path} answered {error.code}') from None
    except urllib.error.URLError as error:
        raise RuntimeError(f'GET {path} failed: {error.reason}') from None


def read_tickets(url, since):
    """`[{id, at, title, outcome, conclusion}]` of the tickets created since `since`, oldest first, from the management API."""
    tickets = []
    for state in ('ended', 'open'):
        offset = 0
        while offset is not None:
            listed = management(url, f'tickets?state={state}&offset={offset}&limit={PAGE}')
            items = listed.get('items') or []
            for ticket in items:
                at = parse_time(ticket['createdAt'])
                if at >= since:
                    tickets.append({'id': ticket['id'][:8], 'ref': ticket['id'], 'created': at, 'at': at.astimezone(SHANGHAI).strftime('%m-%d %H:%M'),
                                    'title': ticket['title'][:160],
                                    'outcome': (ticket.get('ended') or {}).get('outcome', 'open'),
                                    'conclusion': conclusion(ticket.get('summary', '')), 'summary': ticket.get('summary', '')})
            # Lists put the most recently updated first, and a ticket is updated no earlier than it was created.
            offset = listed.get('next_offset')
            if items and parse_time(items[-1]['updatedAt']) < since:
                offset = None
    tickets.sort(key=lambda item: item['at'])
    return tickets[-MAX_TICKETS:]


def lark_get(lark, path, params=None):
    """GET an OpenAPI path as the bot and return its `data`; a failure raises."""
    command = [lark, 'api', 'GET', path, '--as', 'bot', '--format', 'json'] + (['--params', json.dumps(params)] if params else [])
    result = subprocess.run(command, capture_output=True, text=True, timeout=60, check=False)
    try:
        answer = json.loads(result.stdout)
    except ValueError:
        answer = None
    if result.returncode != 0 or not isinstance(answer, dict) or answer.get('ok') is False:
        raise RuntimeError(f'lark-cli GET {path.split("?")[0]} failed: {(result.stderr or result.stdout).strip()[-200:]}')
    return answer.get('data') or {}


def attached_alarms(url):
    """How many alarms of the last 24 hours the main Session attached to an existing ticket instead of opening one."""
    count, offset = 0, 0
    while offset is not None:
        listed = management(url, f'decisions?kind=ignore&window=24h&offset={offset}&limit={PAGE}')
        count += sum(1 for item in listed.get('items') or [] if ':alert:' in str(item.get('thread', ''))
                     and any(reason.get('code') == 'routed' for reason in item.get('reason') or []))
        offset = listed.get('next_offset')
    return count


def ticket_feedback(url, lark, app_id, ticket):
    """`(up, down)`: people's 👍 and 👎 on the bot's replies in the topic of the ticket's Feishu message."""
    page = management(url, f'tickets/{ticket["ref"]}')
    messages = [channel['address']['messageId'] for channel in page.get('channels') or []
                if channel.get('source') == 'feishu' and (channel.get('address') or {}).get('messageId')]
    up = down = 0
    for message in messages[:1]:
        items = lark_get(lark, f'/open-apis/im/v1/messages/{message}').get('items') or [{}]
        topic = items[0].get('thread_id')
        if not topic:
            continue
        listed = lark_get(lark, '/open-apis/im/v1/messages', {'container_id_type': 'thread', 'container_id': topic, 'page_size': 50})
        for reply in listed.get('items') or []:
            if (reply.get('sender') or {}).get('id') != app_id:
                continue
            reactions = lark_get(lark, f'/open-apis/im/v1/messages/{reply["message_id"]}/reactions').get('items') or []
            for reaction in reactions:
                if (reaction.get('operator') or {}).get('operator_type') != 'user':
                    continue
                emoji = str((reaction.get('reaction_type') or {}).get('emoji_type', '')).lower()
                up += emoji in UP
                down += emoji in DOWN
    return up, down


def feedback(url, lark, tickets):
    """`{ticket id: (up, down)}` for the tickets with any 👍 or 👎 on the bot's replies."""
    state = management(url, 'state')
    app_id = (((state.get('setup') or {}).get('accounts') or {}).get('feishu') or {}).get('appId')
    if not app_id:
        raise RuntimeError('the management API names no Feishu bot')
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        counts = dict(zip([ticket['id'] for ticket in tickets], pool.map(lambda ticket: ticket_feedback(url, lark, app_id, ticket), tickets)))
    return {ticket: count for ticket, count in counts.items() if any(count)}


def feedback_markdown(tickets, counts, hours):
    """The digest's feedback section: totals over the feedback window, and each ticket someone marked 👎."""
    if counts is None:
        return ['**分析反馈**：这次没读到（飞书接口失败），下次日报再统计。', '']
    up = sum(count[0] for count in counts.values())
    down = sum(count[1] for count in counts.values())
    lines = [f'**分析反馈**（过去 {hours} 小时 {len(tickets)} 张工单，{len(counts)} 张有反馈）：👍 {up} · 👎 {down}']
    titles = {ticket['id']: ticket for ticket in tickets}
    lines += [f'- 👎 {titles[ticket]["title"]}（{titles[ticket]["at"]}，`{ticket}`）' for ticket, count in counts.items() if count[1]]
    return lines + ['']


def read_fixes(path):
    try:
        return list(json.loads(path.read_text()).values()) if path.exists() else []
    except (OSError, ValueError):
        return []


def fix_of(fixes, ticket_ids):
    """The latest fix oncall-fix started from one of these tickets, or None."""
    found = [fix for fix in fixes if str(fix.get('ticket', ''))[:8] in ticket_ids and fix.get('created')]
    return max(found, key=lambda fix: fix['created']) if found else None


def fix_note(fix, after=None):
    """How far the fix of an issue got, in one Chinese phrase; `after` counts the issue's tickets since its release."""
    link = fix.get('pr_url') or fix.get('repository', '')
    stage = fix.get('stage')
    if stage == 'released':
        when = parse_time(fix['since']).astimezone(SHANGHAI).strftime('%m-%d %H:%M') if fix.get('since') else '?'
        tag = f' {fix["release_tag"]}' if fix.get('release_tag') else ''
        note = f'已修复：{link}（{when} 发布{tag}）'
        if after is None:
            return note
        return note + (f'，发布后仍有 {after} 张，可能没修好' if after else '，发布后没有新工单')
    if stage == 'merged':
        return f'修复已合并、还没发布：{link}'
    if stage == 'ready':
        return f'修复 PR 等人合并：{link}'
    if stage in ('no_pr', 'failed', 'needs_human', 'release_failed'):
        return f'修复没成功（{stage}）：{link}'
    return f'修复进行中：{link}'


def fix_markdown(fixes, hours, now):
    """The digest's line on oncall-fix: fixes started in the window by how far they got, or nothing without fixes."""
    recent = [fix for fix in fixes if now - parse_time(fix['created']) <= datetime.timedelta(hours=hours)]
    if not recent:
        return []
    count = lambda *stages: sum(1 for fix in recent if fix.get('stage') in stages)
    pending = [f'- 等人合并：{fix["pr_url"]}' for fix in recent if fix.get('stage') == 'ready']
    pending += [f'- 需要人看：{fix.get("pr_url") or fix["repository"]}' for fix in recent if fix.get('stage') in ('needs_human', 'failed', 'release_failed')]
    return [f'**自动修复**（过去 {hours} 小时发起 {len(recent)} 个）：进行中 {count("fixing", "review", "revising", "merging", "releasing")} · '
            f'等人合并 {count("ready")} · 已发布 {count("released")} · 没开 PR {count("no_pr")} · '
            f'需要人看 {count("needs_human", "failed", "release_failed")}', *pending, '']


def api_key(credentials, ref):
    """The gateway key named `ref` in the DSH credentials file; it is never printed."""
    text = Path(credentials).read_text()
    match = re.search(r'^\s*' + re.escape(ref) + r'\s*:\s*["\']?([^"\'\n]+)["\']?\s*$', text, re.M)
    if not match:
        raise RuntimeError(f'{ref} not found in {credentials}')
    return match.group(1).strip()


def ask(base_url, key, model, prompt):
    """The model's text answer to one user message through the Anthropic Messages API."""
    body = json.dumps({'model': model, 'max_tokens': 4000, 'messages': [{'role': 'user', 'content': prompt}]}).encode()
    request = urllib.request.Request(base_url.rstrip('/') + '/v1/messages', data=body, method='POST', headers={
        'content-type': 'application/json', 'x-api-key': key, 'anthropic-version': '2023-06-01'})
    try:
        # Grouping a day of tickets can take the gateway several minutes.
        with urllib.request.urlopen(request, timeout=420) as response:
            answer = json.loads(response.read())
    except urllib.error.HTTPError as error:
        raise RuntimeError(f'the gateway answered {error.code}: {error.read()[:300]!r}') from None
    return ''.join(part.get('text', '') for part in answer.get('content') or [] if part.get('type') == 'text')


def parse_answer(text, ticket_ids):
    """The issues and headline of the model's JSON answer; tickets it left out go to one `unsorted` issue."""
    match = re.search(r'\{[\s\S]*\}', text)
    if not match:
        raise RuntimeError('the model answered no JSON object')
    answer = json.loads(match.group(0))
    issues, seen = [], set()
    for issue in answer.get('issues') or []:
        key = re.sub(r'[^a-z0-9-]+', '-', str(issue.get('key', '')).lower()).strip('-')[:48]
        ids = [str(item)[:8] for item in issue.get('ticket_ids') or [] if str(item)[:8] in ticket_ids and str(item)[:8] not in seen]
        if not key or not ids:
            continue
        seen.update(ids)
        issues.append({'key': key, 'title': str(issue.get('title', key))[:80], 'cause': str(issue.get('cause', ''))[:400],
                       'action': str(issue.get('action', ''))[:200], 'owner': str(issue.get('owner', ''))[:30],
                       'needs_human': bool(issue.get('needs_human')), 'ticket_ids': ids})
    left = [item for item in ticket_ids if item not in seen]
    if left:
        issues.append({'key': 'unsorted', 'title': '未归类', 'cause': '', 'action': '', 'owner': '', 'needs_human': False, 'ticket_ids': left})
    return issues, str(answer.get('headline', ''))[:300]


def merge(known, issues, now, fixes=()):
    """The known list after today's issues: matched ones updated, new ones added, quiet ones marked, old quiet ones dropped.

    An issue keeps the ticket its latest fix started from, so later days show how that fix went."""
    by_key = {issue['key']: dict(issue) for issue in known}
    stamp = now.isoformat(timespec='seconds')
    for issue in issues:
        if issue['key'] == 'unsorted':
            continue
        entry = by_key.get(issue['key'], {'key': issue['key'], 'firstSeen': stamp, 'tickets': 0})
        entry.update({k: issue[k] for k in ('title', 'cause', 'action', 'owner', 'needs_human')})
        entry['tickets'] = entry.get('tickets', 0) + len(issue['ticket_ids'])
        entry['lastSeen'] = stamp
        entry['status'] = 'open'
        fix = fix_of(fixes, issue['ticket_ids'])
        if fix:
            entry['fix_ticket'] = fix['ticket'][:8]
        by_key[issue['key']] = entry
    kept = []
    for entry in by_key.values():
        quiet = now - parse_time(entry.get('lastSeen', stamp))
        if quiet > datetime.timedelta(days=DROP_DAYS):
            continue
        if quiet > datetime.timedelta(hours=QUIET_HOURS):
            entry['status'] = 'quiet'
        kept.append(entry)
    return sorted(kept, key=lambda entry: (entry['status'] != 'open', not entry.get('needs_human'), entry.get('lastSeen', '')), reverse=False)


def known_markdown(known, now, fixes=()):
    """The list workers read: one line per open issue with its cause, since when, and what to check before re-investigating."""
    lines = [f'# 已知问题（更新于 {now.astimezone(SHANGHAI):%m-%d %H:%M} 北京时间）', '',
             '新告警先对照这里：如果是同一个问题，先用一两条查询确认它还是同一原因、有没有新变化，再在回复里写明「已知问题：<标题>，自 <首次> 起」，'
             '不必从头排查；只有证据显示原因变了，才按新问题处理。', '']
    for entry in known:
        first = parse_time(entry['firstSeen']).astimezone(SHANGHAI).strftime('%m-%d %H:%M')
        last = parse_time(entry['lastSeen']).astimezone(SHANGHAI).strftime('%m-%d %H:%M')
        tag = '安静' if entry['status'] == 'quiet' else ('需要人处理' if entry.get('needs_human') else '无需处理')
        fix = fix_of(fixes, {entry['fix_ticket']}) if entry.get('fix_ticket') else None
        lines.append(f'- **{entry["title"]}**（`{entry["key"]}`，{tag}，{entry.get("tickets", 0)} 张工单，首次 {first}，最近 {last}）：{entry["cause"]} 建议：{entry["action"]}'  # noqa: E501
                     + (f' {fix_note(fix)}。' if fix else ''))
    return '\n'.join(lines) + '\n'


def digest_markdown(issues, headline, hours, total, now, feedback_lines=(), known=(), fixes=(), tickets=()):
    """The digest. An issue whose fix was released and has no ticket since is listed under 已修复, as is a known issue
    whose fix was released in the window and that had no ticket in it, so a fixed problem is not read as unhandled."""
    stamp = now.astimezone(SHANGHAI).strftime('%m-%d %H:%M')
    created = {ticket['id']: ticket['created'] for ticket in tickets}
    by_key = {entry['key']: entry for entry in known}
    notes, fixed = {}, []
    for issue in issues:
        entry = by_key.get(issue['key'], {})
        fix = fix_of(fixes, {entry['fix_ticket']}) if entry.get('fix_ticket') else None
        if not fix:
            continue
        after = None
        if fix.get('stage') == 'released' and fix.get('since'):
            after = sum(1 for ticket_id in issue['ticket_ids'] if ticket_id in created and created[ticket_id] > parse_time(fix['since']))
        notes[issue['key']] = fix_note(fix, after)
        if after == 0:
            fixed.append(issue)
    open_issues = [issue for issue in issues if issue not in fixed]
    human = [issue for issue in open_issues if issue['needs_human']]
    rest = [issue for issue in open_issues if not issue['needs_human']]
    note = lambda issue: f'（{notes[issue["key"]]}）' if issue['key'] in notes else ''
    lines = [f'**工单日报 {stamp}**（过去 {hours} 小时，{total} 张工单，归为 {len(issues)} 类）', headline, '']
    if human:
        lines.append('**需要人处理**')
        lines += [f'- **{issue["title"]}**（{len(issue["ticket_ids"])} 张，{issue["owner"] or "待定"}）：{issue["action"]}{note(issue)}' for issue in human]
        lines.append('')
    if rest:
        lines.append('**无需处理**')
        lines += [f'- {issue["title"]}（{len(issue["ticket_ids"])} 张）' + (f'：{issue["action"]}' if issue['action'] and issue['action'] != '无需处理' else '')
                  + note(issue) for issue in rest]
        lines.append('')
    seen = {issue['key'] for issue in issues}
    window = datetime.timedelta(hours=hours)
    quiet_fixed = []
    for entry in known:
        fix = fix_of(fixes, {entry['fix_ticket']}) if entry.get('fix_ticket') and entry['key'] not in seen else None
        if fix and fix.get('stage') == 'released' and fix.get('since') and now - parse_time(fix['since']) <= window:
            quiet_fixed.append(f'- {entry["title"]}：{fix_note(fix)}，之后没有新工单')
    if fixed or quiet_fixed:
        lines.append('**已修复**')
        lines += [f'- {issue["title"]}（{len(issue["ticket_ids"])} 张，都在发布前）：{notes[issue["key"]]}' for issue in fixed]
        lines += quiet_fixed
        lines.append('')
    lines += list(feedback_lines)
    lines.append('想看某一类的工单，在群里 @ 值班机器人问；分析有用或不对，在那条回复上点 👍 或 👎。')
    return '\n'.join(lines)


def worker_seen(sessions, ticket_ref):
    """What a ticket's worker saw, from its Session on this machine: the messages it was given and its tool calls and results,
    each cut to ITEM_CHARS and the whole to SEEN_CHARS (its middle left out); empty when the Session is not here."""
    out = []
    for path in glob.glob(os.path.join(sessions, '*', f'worker-{ticket_ref}', 'session*.zstd')):
        text = subprocess.run(['zstd', '-dc', path], capture_output=True, timeout=60).stdout.decode('utf-8', 'ignore')
        for line in text.split('\n'):
            try:
                event = json.loads(line)
            except ValueError:
                continue
            data = event.get('data') or {}
            parts = lambda message: ''.join(part.get('text', '') for part in (message.get('content') or [])
                                            if isinstance(message.get('content'), list) and isinstance(part, dict))
            if event.get('type') == 'user/message':
                body = parts(data)
                if body and 'Time sampled while preparing' not in body:
                    out.append(f'[input] {body[:ITEM_CHARS]}')
            elif event.get('type') == 'tool/call':
                out.append(f'[call {data.get("name")}] {str(data.get("arguments", ""))[:1500]}')
            elif event.get('type') == 'tool/result':
                message = data.get('message') or {}
                out.append(f'[result{" ERROR" if message.get("isError") else ""}] {parts(message)[:ITEM_CHARS]}')
    seen = '\n'.join(out)
    return seen if len(seen) <= SEEN_CHARS else seen[:SEEN_CHARS // 2] + '\n...[middle omitted]...\n' + seen[-SEEN_CHARS // 2:]


def confidence(summary):
    """The confidence the reply's 结论 states: 高, 中, 低, or '' when it states none."""
    match = re.search(r'\*\*结论\*\*[:：]?\s*(.+)', summary)
    found = re.search(r'置信度[^高中低\n]{0,4}([高中低])', match.group(1)) if match else None
    return found.group(1) if found else ''


def check_evidence(tickets, sessions, size, ask_model):
    """`[{ticket, major, minor}]` for a sample of up to `size` finished tickets whose reply states a cause and whose worker's
    Session is here; the sample is drawn by the date, so a rerun of the same day checks the same tickets."""
    ready = [ticket for ticket in tickets if ticket['outcome'] == 'completed' and '**结论**' in ticket['summary']
             and '已知问题' not in ticket['summary'][:400]]
    random.Random(now_utc().strftime('%Y-%m-%d')).shuffle(ready)
    checked = []
    for ticket in ready:
        if len(checked) >= size:
            break
        seen = worker_seen(sessions, ticket['ref'])
        if not seen:
            continue
        reply = ticket['summary'].split('\n---\n')[0][:6000]
        try:
            text = ask_model(CHECK_PROMPT.format(reply=reply, seen=seen))
            match = re.search(r'\{[\s\S]*\}', text)
            verdict = json.loads(match.group(0)) if match else {}
        except (RuntimeError, ValueError, OSError) as error:
            print(f'oncall-ticket-digest: evidence check of {ticket["id"]} failed: {error}', file=sys.stderr)
            continue
        checked.append({'ticket': ticket, 'confidence': confidence(ticket['summary']),
                        'major': [str(item)[:200] for item in verdict.get('major') or []][:3],
                        'minor': [str(item)[:200] for item in verdict.get('minor') or []]})
    return checked


def evidence_markdown(checked):
    """The digest's lines on the evidence check: how many replies have a major issue, how many of the 高 ones do, and each one."""
    if not checked:
        return []
    major = [item for item in checked if item['major']]
    high = [item for item in checked if item['confidence'] == '高']
    high_major = [item for item in high if item['major']]
    lines = [f'**证据抽查**（{len(checked)} 张给出原因的工单）：{len(major)} 张结论缺证据或与证据矛盾'
             + (f'，其中置信度高的 {len(high_major)}/{len(high)} 张' if high else '')
             + f'；{sum(1 for item in checked if not item["major"] and item["minor"])} 张只有细节问题。']
    lines += [f'- {item["ticket"]["title"][:60]}（`{item["ticket"]["id"]}`）：{item["major"][0]}' for item in major]
    return lines + ['']


BRIEF_PROMPT = """You write a short summary of the on-call alert chat for engineers who do not read every alarm.

Below are, for the last {hours} hours: the alarm rules that fired and how often, the tickets the on-call agent opened or
rechecked with the conclusion of each, and the known open issues from earlier days. Answer with one JSON object and nothing
else:
{{"attention": [{{"title": "short Chinese title naming the thing", "why": "one Chinese sentence: what is wrong and what a person
  should do", "ticket_ids": ["..."]}}],
 "ongoing": [{{"title": "short Chinese title of a known issue that kept firing", "alarms": number of its alarms in the window}}],
 "headline": "one Chinese sentence on the window"}}

attention lists only what a person must act on and that is new in this window or got worse: a real fault, a broken page,
a quota, a certificate, a cause that changed. A false alarm, a known issue firing as before, a recovered blip or a client's
own traffic is not attention; a known issue firing as before goes to ongoing. A ticket still being investigated (outcome
open, no conclusion yet) is not attention by itself: the next summary has its conclusion. Keep attention to at most five items, the
most urgent first, and say so plainly when there are none. Use only what the conclusions say; do not invent causes.

Alarm rules (rule: firing alarms):
{rules}

Tickets:
{tickets}

Known issues:
{known}
"""


def alarm_decisions(url, since):
    """The decisions on alert Threads made since `since`, newest first, from the management API."""
    found, offset = [], 0
    while offset is not None:
        listed = management(url, f'decisions?offset={offset}&limit={PAGE}')
        items = listed.get('items') or []
        for item in items:
            if parse_time(item['at']) < since:
                return found
            if ':alert:' in str(item.get('thread', '')):
                found.append(item)
        offset = listed.get('next_offset')
    return found


def handling(decision):
    """How an alarm was handled: new, recheck, repeat, recovered, timeout or other."""
    reason = json.dumps(decision.get('reason') or [], ensure_ascii=False)
    if decision.get('kind') == 'accept':
        return 'new'
    if decision.get('kind') == 'unavailable':
        return 'timeout'
    if '"routed"' in reason:
        return 'recheck'
    if 'alert_recovered' in reason:
        return 'recovered'
    if any(word in reason for word in ('alert_analysed', 'alert_repeat', '6-hour', 'Same alarm', 'Same incident')):
        return 'repeat'
    return 'other'


REVIEW_PROMPT = """You check a summary an on-call bot is about to post to engineers. Each item below claims something needs a
person, and comes with the full report of the ticket it cites. For each item, answer whether the report supports it:
"keep" when the report states the problem and that a person must act; "doubt" when the report is unsure (low confidence,
open questions) but the item may still be right; "drop" when the report does not say it, says the opposite, calls it a false
alarm, a known issue firing as before, a client's own traffic or already recovered, or when nobody needs to act.

Answer with one JSON object and nothing else: {{"verdicts": [{{"index": 0, "verdict": "keep" | "doubt" | "drop", "reason":
"one short Chinese sentence"}}]}}

Items:
{items}
"""


def cited(attention, tickets):
    """The attention items that cite at least one ticket of the window with a conclusion, each with those tickets."""
    by_id = {ticket['id']: ticket for ticket in tickets if ticket.get('conclusion')}
    kept = []
    for item in attention:
        found = [by_id[str(ticket_id)[:8]] for ticket_id in item.get('ticket_ids') or [] if str(ticket_id)[:8] in by_id]
        if found:
            kept.append({**item, 'tickets': found})
        else:
            print(f'oncall-ticket-digest: left out {item.get("title")!r}: it names no ticket of the window with a conclusion', file=sys.stderr)
    return kept


def review(attention, ask_model):
    """The attention items a second model call finds supported by their tickets' reports, marked `doubt` when it is unsure."""
    if not attention:
        return []
    shown = [{'index': index, 'title': item.get('title'), 'why': item.get('why'),
              'reports': [ticket['summary'][:ITEM_CHARS] for ticket in item['tickets']]} for index, item in enumerate(attention)]
    text = ask_model(REVIEW_PROMPT.format(items=json.dumps(shown, ensure_ascii=False, indent=0)))
    match = re.search(r'\{[\s\S]*\}', text)
    if not match:
        raise RuntimeError('the review answered no JSON object')
    answered = {verdict.get('index'): verdict for verdict in json.loads(match.group(0)).get('verdicts') or []}
    verdicts = {index: verdict.get('verdict') for index, verdict in answered.items()}
    for index, item in enumerate(attention):
        if verdicts.get(index) not in ('keep', 'doubt'):
            reason = (answered.get(index) or {}).get('reason') or 'no verdict'
            print(f'oncall-ticket-digest: left out {item.get("title")!r}: the review said {verdicts.get(index)}: {reason}', file=sys.stderr)
    # An item the review did not answer is not posted: the review is what lets it through.
    return [{**item, 'doubt': verdicts[index] == 'doubt'} for index, item in enumerate(attention) if verdicts.get(index) in ('keep', 'doubt')]


def brief_markdown(answer, counts, hours, now, attention=None):
    stamp = now.astimezone(SHANGHAI)
    start = (stamp - datetime.timedelta(hours=hours)).strftime('%H:%M')
    total = sum(counts.values())
    lines = [f'**告警摘要 {start}–{stamp:%H:%M}**（{total} 条告警：新开工单 {counts["new"]} · 复核 {counts["recheck"]} · '
             f'重复已跳过 {counts["repeat"]} · 恢复 {counts["recovered"]}'
             + (f' · 超时未判断 {counts["timeout"]}' if counts['timeout'] else '') + (f' · 其他 {counts["other"]}' if counts['other'] else '') + '）']
    if answer.get('headline'):
        lines.append(str(answer['headline'])[:300])
    if attention is None:
        attention = [item for item in answer.get('attention') or [] if item.get('title')][:5]
    lines += ['', '**需要关注**'] + ([f'- **{item["title"][:60]}**' + ('（待确认）' if item.get('doubt') else '')
                                     + f'：{str(item.get("why", ""))[:200]}' + (f'（工单 `{item["tickets"][0]["id"]}`）' if item.get('tickets') else '')
                                     for item in attention] or ['- 无'])
    ongoing = [item for item in answer.get('ongoing') or [] if item.get('title')][:8]
    if ongoing:
        lines += ['', '**持续中的已知问题**'] + [f'- {item["title"][:60]}（{item.get("alarms", "?")} 条）' for item in ongoing]
    return '\n'.join(lines)


def post(lark, chat, text):
    with tempfile.TemporaryDirectory(prefix='ticket-digest-') as scratch:
        Path(scratch, 'digest.md').write_text(text)
        result = subprocess.run([lark, 'im', '+messages-send', '--chat-id', chat, '--markdown', '@digest.md', '--as', 'bot'],
                                cwd=scratch, capture_output=True, text=True, timeout=120)
    if result.returncode != 0:
        raise RuntimeError(f'lark-cli send exited {result.returncode}: {(result.stderr or result.stdout).strip()[-300:]}')


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--url', default=os.environ.get('DSH_SUPERAGENT_URL') or 'http://127.0.0.1:3082',
                        help='the dsh-superagent management API on loopback (default http://127.0.0.1:3082)')
    parser.add_argument('--known', required=True, type=Path, help='the known-issues JSON; a .md beside it is written for workers')
    parser.add_argument('--chat', required=True, help='the Feishu chat id to post to')
    parser.add_argument('--hours', type=int)
    parser.add_argument('--credentials', default=os.path.expanduser('~/.dsh/.credentials.yaml'))
    parser.add_argument('--key-ref', default='ONCALL_LLM_API_KEY')
    parser.add_argument('--base-url', default=os.environ.get('ONCALL_LLM_BASE_URL', ''))
    parser.add_argument('--model', default=os.environ.get('ONCALL_DIGEST_MODEL', ''))
    parser.add_argument('--lark-cli', default='lark-bot')
    parser.add_argument('--fix-state', type=Path, default=Path.home() / '.local' / 'state' / 'oncall-fix.json',
                        help='the oncall-fix state, whose fixes of the feedback window are counted')
    parser.add_argument('--feedback-hours', type=int, default=48, help='count 👍/👎 on replies of the tickets of this many hours (0: none)')
    parser.add_argument('--sessions', default='', help='the DSH sessions directory, such as ~/.dsh/sessions, to check workers\' evidence')
    parser.add_argument('--check', type=int, default=10, help='how many tickets the evidence check reads (0: none)')
    parser.add_argument('--brief', action='store_true', help='post the short alarm summary of the last --hours (default 3) instead')
    parser.add_argument('--dry-run', action='store_true', help='print the digest and the known list; post and write nothing')
    args = parser.parse_args()
    if args.hours is None:
        args.hours = 3 if args.brief else 24
    try:
        if not re.fullmatch(r'oc_[A-Za-z0-9]+', args.chat):
            raise Invalid('--chat must be a Feishu chat id (oc_...)')
        if not re.fullmatch(r'http://(127\.0\.0\.1|localhost)(:\d+)?/?', args.url):
            raise Invalid('--url must be the loopback management API, such as http://127.0.0.1:3082')
        if not 1 <= args.hours <= 168:
            raise Invalid('--hours must be 1-168')
        if not 0 <= args.feedback_hours <= 168:
            raise Invalid('--feedback-hours must be 0-168')
        if not 0 <= args.check <= 30:
            raise Invalid('--check must be 0-30')
        if args.sessions and not os.path.isdir(os.path.expanduser(args.sessions)):
            raise Invalid('--sessions must be a directory')
        if not args.base_url.startswith('https://') or not args.model:
            raise Invalid('--base-url (https://...) and --model are required, or ONCALL_LLM_BASE_URL and ONCALL_DIGEST_MODEL')
    except Invalid as error:
        print(f'oncall-ticket-digest: {error}', file=sys.stderr)
        return 2
    now = now_utc()
    if args.brief:
        return brief(args, now)
    try:
        tickets = read_tickets(args.url, now - datetime.timedelta(hours=args.hours))
        known = json.loads(args.known.read_text()) if args.known.exists() else []
        fixes = read_fixes(args.fix_state)
        evidence = []
        if tickets:
            fixed_by = {str(fix.get('ticket', ''))[:8]: fix['pr_url'] for fix in sorted(fixes, key=lambda fix: fix.get('created', '')) if fix.get('pr_url')}
            hidden = ('ref', 'created', 'summary')
            shown = [{k: v for k, v in ticket.items() if k not in hidden} | ({'fix_pr': fixed_by[ticket['id']]} if ticket['id'] in fixed_by else {})
                     for ticket in tickets]
            prompt = PROMPT.format(hours=args.hours, known=json.dumps([{k: entry.get(k) for k in ('key', 'title', 'cause', 'status')} for entry in known],
                                                                         ensure_ascii=False), tickets=json.dumps(shown, ensure_ascii=False, indent=0))
            issues, headline = parse_answer(ask(args.base_url, api_key(args.credentials, args.key_ref), args.model, prompt), [t['id'] for t in tickets])
            if args.sessions and args.check:
                key = api_key(args.credentials, args.key_ref)
                checked = check_evidence(tickets, os.path.expanduser(args.sessions), args.check,
                                         lambda text: ask(args.base_url, key, args.model, text))
                evidence = evidence_markdown(checked)
        else:
            issues, headline = [], f'过去 {args.hours} 小时没有工单。'
        known = merge(known, issues, now, fixes)
        lines = []
        if args.feedback_hours:
            marked = read_tickets(args.url, now - datetime.timedelta(hours=args.feedback_hours))
            try:
                counts = feedback(args.url, args.lark_cli, marked)
            except (RuntimeError, OSError, subprocess.TimeoutExpired) as error:
                print(f'oncall-ticket-digest: feedback not read: {error}', file=sys.stderr)
                counts = None
            lines = feedback_markdown(marked, counts, args.feedback_hours)
        lines = fix_markdown(fixes, args.feedback_hours or 48, now) + evidence + lines
        if args.hours == 24:
            attached = attached_alarms(args.url)
            if attached:
                lines = [f'**告警归并**：过去 24 小时 {attached} 条告警挂到已有工单复核，没有新开工单。', ''] + lines
        text = digest_markdown(issues, headline, args.hours, len(tickets), now, lines, known, fixes, tickets)
        if args.dry_run:
            print(text)
            print('\n---\n' + known_markdown(known, now, fixes))
            return 0
        args.known.parent.mkdir(parents=True, exist_ok=True)
        args.known.write_text(json.dumps(known, ensure_ascii=False, indent=1) + '\n')
        args.known.with_suffix('.md').write_text(known_markdown(known, now, fixes))
        post(args.lark_cli, args.chat, text)
    except (RuntimeError, OSError, ValueError, KeyError, subprocess.TimeoutExpired) as error:
        print(f'oncall-ticket-digest: {error}', file=sys.stderr)
        return 1
    return 0


def brief(args, now):
    since = now - datetime.timedelta(hours=args.hours)
    try:
        decisions = alarm_decisions(args.url, since)
        if not decisions:
            print('oncall-ticket-digest: no alarms in the window; nothing posted')
            return 0
        counts = dict.fromkeys(('new', 'recheck', 'repeat', 'recovered', 'timeout', 'other'), 0)
        rules = {}
        for decision in decisions:
            kind = handling(decision)
            counts[kind] += 1
            if kind != 'recovered':
                rule = str(decision.get('threadTitle') or '').split(' · ')[0][:80] or '?'
                rules[rule] = rules.get(rule, 0) + 1
        tickets = read_tickets(args.url, since)
        known = json.loads(args.known.read_text()) if args.known.exists() else []
        shown = [{k: v for k, v in ticket.items() if k not in ('ref', 'created', 'summary')} for ticket in tickets]
        prompt = BRIEF_PROMPT.format(hours=args.hours,
                                     rules='\n'.join(f'{rule}: {n}' for rule, n in sorted(rules.items(), key=lambda item: -item[1])),
                                     tickets=json.dumps(shown, ensure_ascii=False, indent=0),
                                     known=json.dumps([{k: entry.get(k) for k in ('title', 'cause', 'needs_human', 'firstSeen')}
                                                       for entry in known if entry.get('status') == 'open'], ensure_ascii=False))
        key = api_key(args.credentials, args.key_ref)
        text = ask(args.base_url, key, args.model, prompt)
        match = re.search(r'\{[\s\S]*\}', text)
        if not match:
            raise RuntimeError('the model answered no JSON object')
        answer = json.loads(match.group(0))
        proposed = [item for item in answer.get('attention') or [] if item.get('title')][:5]
        attention = review(cited(proposed, tickets), lambda text: ask(args.base_url, key, args.model, text))
        if len(attention) < len(proposed):
            print(f'oncall-ticket-digest: {len(proposed) - len(attention)} of {len(proposed)} attention items left out by the checks', file=sys.stderr)
        markdown = brief_markdown(answer, counts, args.hours, now, attention)
        if args.dry_run:
            print(markdown)
            return 0
        post(args.lark_cli, args.chat, markdown)
    except (RuntimeError, OSError, ValueError, KeyError, subprocess.TimeoutExpired) as error:
        print(f'oncall-ticket-digest: {error}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
